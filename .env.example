# انسخ هذا الملف إلى .env وغيّر القيم. لا تضع أسراراً حقيقية في المستودع.
APP_URL=http://72.61.18.234:8098
HOST_HTTP_PORT=8098

POSTGRES_USER=saha
POSTGRES_DB=saha
POSTGRES_PASSWORD=غيّرني_كلمة_سر_طويلة
DATABASE_URL=postgresql://saha:غيّرني_كلمة_سر_طويلة@db:5432/saha
REDIS_URL=redis://redis:6379

JWT_SECRET=نص_عشوائي_64_حرفاً
JWT_REFRESH_SECRET=نص_عشوائي_64_حرفاً_آخر
AUDIT_HMAC_SECRET=نص_عشوائي_آخر

OTP_PROVIDER=dev
STORAGE_DIR=/data/uploads
# فحص انتهاء مهلة الاعتراض كل كم ثانية (0 = إيقاف)
RESULT_SWEEP_SECONDS=60
# إشعارات الهاتف عبر Expo Push: فحص كل كم ثانية (0 = إيقاف)، وoff لإيقاف الإرسال كلياً
PUSH_SWEEP_SECONDS=5
PUSH_PROVIDER=expo
# معرّف مشروع Expo (لرموز الأجهزة في Expo Go) — يمكن وضعه في apps/mobile/app.json بدلاً من هنا
EXPO_PROJECT_ID=

ADMIN_EMAIL=admin@saha.local
ADMIN_INITIAL_PASSWORD=غيّرني_بعد_أول_دخول

# بيانات تجريبية للعرض تُزرع عند أول تشغيل إن كانت القاعدة فارغة
SEED_DEMO=true
NOINDEX=true
TZ=Asia/Baghdad
